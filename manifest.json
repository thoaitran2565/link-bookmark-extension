{
  "manifest_version": 3,
  "name": "Smart Link Bookmarker",
  "version": "1.0",
  "description": "Lưu và quản lý link thông minh phân nhóm theo Domain",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "tabs",
    "favicon"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}